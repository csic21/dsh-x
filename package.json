{
  "name": "dsh-x",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test packages/*/test/*.test.js test/*.test.js",
    "test:unit": "node --test packages/*/test/*.test.js",
    "test:integration": "node --test test/*.test.js",
    "link:plugins": "node scripts/link-plugins.mjs",
    "build": "npm --prefix packages/dsh-x-stock run build && npm --prefix packages/dsh-x-chat run build && npm --prefix packages/dsh-x-plan run build && npm --prefix packages/dsh-x-agents run build && npm --prefix packages/dsh-x-code run build",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.302",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.5",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "lightweight-charts": "5.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}

{
  "name": "dsh-x-ui",
  "version": "0.1.0",
  "description": "Liquid-glass surface treatment for the Harness Web UI: translucent panels, a living backdrop, and real blur on elevated surfaces",
  "type": "module",
  "main": "./lib/index.js",
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.0-rc.2 || ^0.2.1-rc.2"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "VALIDATION.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "pretest": "pnpm run build",
    "test": "node --max-old-space-size=2048 --test --test-concurrency=1 test/*.test.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
